{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalNative",
  "version": "0.5.2",
  "identifier": "app.localnative",
  "build": {
    "beforeBuildCommand": "yarn run build",
    "beforeDevCommand": "yarn run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "resizable": true,
        "title": "Local Native",
        "minHeight": 800,
        "minWidth": 1270,
        "url": "/notes"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://tauri.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "",
    "longDescription": "",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "resources": [],
    "targets": "all",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbWVudDogaW1pbmlzaWduIHB1YmxpYyBrZXk6IDNCQ0YzMDIyOEU4OUM5QTUKUldTbHlZbU9JakRQTzBKUzRsSVhvT3NpUzhpMDF5YnFSVVpxOGtPOEhHQ0U3T0FsUW84TlloRU0K",
      "endpoints": [
        "https://localnative.app/updater/update.json"
      ]
    }
  }
}
