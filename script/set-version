#!/bin/bash
#
# Set the shared version for the Rust workspace crates and the matching npm CLI
# package. Also update path-dependency constraints and lockfiles so release
# builds with --locked cannot select an older local core. PyPI reads Cargo.
#
# This deliberately does NOT touch the browser extension, Android, iOS, Tauri,
# Electron or macOS. Those version independently against their own stores'
# rules; forcing one number across all of them is what froze the browser
# extension at 0.5.1 until the Chrome Web Store removed it.
# See docs/VERSIONING.md.

set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: $(basename "$0") <version>    e.g. $(basename "$0") 0.8.1" >&2
  exit 1
fi

cd "$(dirname "$0")/.."
version=$1
manifest=localnative-rs/Cargo.toml

# Guard the anchor rather than trusting a line number: the previous version of
# this script wrote by offset and silently overwrote unrelated lines as files
# shifted underneath it.
count=$(grep -c '^version = ' "$manifest" || true)
if [ "$count" -ne 1 ]; then
  echo "error: expected exactly one '^version = ' line in $manifest, found $count" >&2
  exit 1
fi

sed -i.bak -E "s/^version = \".*\"$/version = \"$version\"/" "$manifest"
rm -f "$manifest.bak"

cli_manifest=localnative-rs/localnative_cli/Cargo.toml
dependency_count=$(grep -c '^localnative_.* = { version = "' "$cli_manifest" || true)
if [ "$dependency_count" -ne 2 ]; then
  echo "error: expected two versioned path dependencies in $cli_manifest, found $dependency_count" >&2
  exit 1
fi
sed -i.bak -E "s/^(localnative_(core|hostinstall) = \{ version = \")[^\"]+/\1$version/" "$cli_manifest"
rm -f "$cli_manifest.bak"

node -e 'const fs = require("fs"); const path = "packaging/npm/package.json"; const pkg = JSON.parse(fs.readFileSync(path, "utf8")); pkg.version = process.argv[1]; fs.writeFileSync(path, JSON.stringify(pkg, null, 2) + "\n");' "$version"

cargo metadata --format-version 1 --no-deps --manifest-path "$manifest" > /dev/null
cargo metadata --format-version 1 --no-deps --manifest-path localnative-tauri/src-tauri/Cargo.toml > /dev/null

echo "rust workspace and npm CLI version set to $version"
grep -n '^version = ' "$manifest"
node -p '"npm package version " + require("./packaging/npm/package.json").version'
