#!/bin/bash
# Package the Iced macOS release produced by `cargo xtask release`.
set -e
cd "$(dirname "$0")/.."

VERSION=$1
if [ -z "$VERSION" ]; then
  echo "usage: $0 <version>" >&2
  exit 1
fi

cd localnative-rs
# cargo xtask release -v $VERSION

DMG=$(ls dist/bundle/macos/rw.localnative_iced_"$VERSION"_*.dmg 2>/dev/null | head -1)
if [ -z "$DMG" ]; then
  echo "no dmg matching dist/bundle/macos/rw.localnative_iced_${VERSION}_*.dmg" >&2
  exit 1
fi

DIR="../../localnative-release/v$VERSION/mac/"
mkdir -p "$DIR"
FILE="Local Native-$VERSION.dmg"
cp "$DMG" "$DIR/$FILE"
cd "$DIR"
shasum -a 256 "$FILE" > "$FILE.sha256"
md5 "$FILE" > "$FILE.md5"
