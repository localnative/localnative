{
  "name": "Local Native",
  "version": "0.5.1",
  "manifest_version": 3,
  "description": "Local Native notes taking.",
  "icons": {
    "512": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "permissions": [
    "nativeMessaging",
    "scripting",
    "storage",
    "activeTab"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; connect-src 'none'; object-src 'none'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "localnative@example.org",
      "strict_min_version": "128.0"
    }
  }
}
