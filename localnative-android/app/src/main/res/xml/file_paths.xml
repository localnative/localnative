<?xml version="1.0" encoding="utf-8"?>
<!--
    Paths shared via androidx FileProvider (authority "${applicationId}.fileprovider").
    The database export is written to the app's external files dir, which is also
    visible over USB/MTP under Android/data/app.localnative/files. The internal
    files-path is a fallback for devices with no external storage.
-->
<paths>
    <external-files-path name="export" path="." />
    <files-path name="internal" path="." />
</paths>
