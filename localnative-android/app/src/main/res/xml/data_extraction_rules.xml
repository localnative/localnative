<?xml version="1.0" encoding="utf-8"?>
<!--
  The notes database is private and never leaves the device through Android
  cloud backup (allowBackup="false" above). Device-to-device transfer is
  allowed so a new phone can carry the library over.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
